layout: null
sitemap: false
---
{
  "name": "{{ site.title }}",
  "short_name": "{{ site.title }}",
  "icons": [
    { "src": "{{ '/assets/icons/icon-192.png' | relative_url }}", "sizes": "192x192", "type": "image/png" },
    { "src": "{{ '/assets/icons/icon-512.png' | relative_url }}", "sizes": "512x512", "type": "image/png" }
  ],
  "start_url": "{{ '/' | relative_url }}",
  "display": "browser",
  "background_color": "#ffffff",
  "theme_color": "#ffffff"
}
